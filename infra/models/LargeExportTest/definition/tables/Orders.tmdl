	hierarchy 'Sales Geography'
		lineageTag: 55555555-0000-0000-0000-000000000300

		level Area
			lineageTag: 55555555-0000-0000-0000-000000000301
			column: Region

		level Line
			lineageTag: 55555555-0000-0000-0000-000000000302
			column: Category

	hierarchy 'Order Calendar'
		lineageTag: 55555555-0000-0000-0000-000000000310

		level Year
			lineageTag: 55555555-0000-0000-0000-000000000311
			column: 'Order Year'

		level Month
			lineageTag: 55555555-0000-0000-0000-000000000312
			column: 'Order Month'

	partition Orders = calculated
		mode: import
		source =
				VAR _base = GENERATESERIES(1, 2000000, 1)
				VAR _h =
					ADDCOLUMNS(
						_base,
						"@h1", MOD([Value] * 48271, 2147483647),
						"@h2", MOD([Value] * 69621, 2147483647),
						"@h3", MOD([Value] * 16807, 2147483647),
						"@h4", MOD([Value] * 39373, 2147483647),
						"@h5", MOD([Value] * 40692, 2147483399)
					)
				RETURN
					SELECTCOLUMNS(
						_h,
						"Row Id", CONVERT([Value], INTEGER),
						"Order Number", "ORD-" & FORMAT([Value], "0000000"),
						"Region", SWITCH(MOD([Value], 4), 0, "North", 1, "South", 2, "East", "West"),
						"Category", SWITCH(MOD([@h1], 10), 0, "Hardware", 1, "Software", 2, "Services", 3, "Accessories", 4, "Furniture", 5, "Office Supplies", 6, "Electronics", 7, "Apparel", 8, "Grocery", "Toys"),
						"Product Name", SWITCH(MOD([@h2], 12), 0, "Bolt, Hex 10mm", 1, "Pipe 3/4"" Copper", 2, "Café Crème Mug", 3, "Ünïcødé Widget ✓", 4, "日本製 Knife", 5, "Multi-line" & UNICHAR(10) & "Label", 6, "Quote ""Special"" Edition", 7, "Semi;Colon Kit", 8, "Tab" & UNICHAR(9) & "Separated", 9, "  Padded Name  ", 10, "=1+1 Formula Text", "Standard Widget"),
						"Customer Name", "Customer " & FORMAT(MOD([@h3], 50000), "00000"),
						"Postal Code", FORMAT(MOD([@h4], 100000), "00000"),
						"Quantity", CONVERT(1 + MOD([@h1], 500), INTEGER),
						"Unit Price", CONVERT(0.99 + MOD([@h2], 100000) / 100, CURRENCY),
						"Discount Pct", CONVERT(MOD([@h3], 3001) / 10000, DOUBLE),
						"Sales Amount", CONVERT((1 + MOD([@h1], 500)) * (0.99 + MOD([@h2], 100000) / 100) * (1 - MOD([@h3], 3001) / 10000) * IF(MOD([@h5], 20) = 0, -1, 1), CURRENCY),
						"Unit Cost", CONVERT((0.99 + MOD([@h2], 100000) / 100) * (0.4 + MOD([@h4], 5000) / 10000), DOUBLE),
						"Margin Ratio", CONVERT((MOD([@h5], 2001) - 1000) / 1000, DOUBLE),
						"Weight Kg", CONVERT([@h4] / 1000003, DOUBLE),
						"Scientific Value", CONVERT(POWER(10, MOD([@h1], 19) - 6) * (1 + MOD([@h2], 1000) / 1000), DOUBLE),
						"Big Integer", CONVERT(9007199254740000 + [Value], INTEGER),
						"Priority Code", CONVERT(MOD([@h3], 1000), INTEGER),
						"Rating", CONVERT(1 + MOD([@h4], 41) / 10, DOUBLE),
						"Tax Rate", CONVERT(MOD([@h5], 13) / 100, CURRENCY),
						"Temperature", CONVERT((MOD([@h2], 901) - 400) / 10, DOUBLE),
						"Contract Value", CONVERT([@h1] * 1.2345, CURRENCY),
						"Order Date", CONVERT(DATE(2020, 1, 1) + MOD([@h1], 2192), DATETIME),
						"Ship Date", CONVERT(DATE(2020, 1, 1) + MOD([@h1], 2192) + MOD([@h2], 15), DATETIME),
						"Order Timestamp", CONVERT(DATE(2020, 1, 1) + MOD([@h1], 2192) + TIME(MOD([@h3], 24), MOD([@h4], 60), MOD([@h5], 60)), DATETIME),
						"Order Time", CONVERT(TIME(MOD([@h3], 24), MOD([@h4], 60), MOD([@h5], 60)), DATETIME),
						"Is Returned", MOD([@h5], 20) = 0,
						"Nullable Amount", IF(MOD([Value], 7) = 0, BLANK(), CONVERT(MOD([@h4], 1000000) / 100, DOUBLE)),
						"Notes", SWITCH(MOD([@h3], 5), 0, BLANK(), 1, "", 2, "Rush order", 3, "Gift wrap, with ""fragile"" sticker", "N/A"),
						"Order Year", CONVERT(YEAR(DATE(2020, 1, 1) + MOD([@h1], 2192)), INTEGER),
						"Order Month", FORMAT(DATE(2020, 1, 1) + MOD([@h1], 2192), "yyyy-mm"),
						"Internal Hash", FORMAT([@h1], "0000000000")
					)

	annotation PBI_ResultType = Table
