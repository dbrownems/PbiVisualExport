table Orders
	lineageTag: 55555555-0000-0000-0000-000000000001

	measure 'Order Count' = COUNTROWS(Orders)
		formatString: #,0
		lineageTag: 55555555-0000-0000-0000-000000000100

	measure 'Total Sales' = SUM(Orders[Sales Amount])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 55555555-0000-0000-0000-000000000101

	measure 'Total Quantity' = SUM(Orders[Quantity])
		formatString: #,0
		lineageTag: 55555555-0000-0000-0000-000000000102

	measure 'Avg Discount' = AVERAGE(Orders[Discount Pct])
		formatString: 0.00%
		lineageTag: 55555555-0000-0000-0000-000000000103

	measure 'Return Rate' = DIVIDE(CALCULATE(COUNTROWS(Orders), Orders[Is Returned] = TRUE()), COUNTROWS(Orders))
		formatString: 0.0%
		lineageTag: 55555555-0000-0000-0000-000000000104

