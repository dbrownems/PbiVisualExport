{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "matrix1",
  "position": { "x": 16, "y": 16, "z": 0, "width": 620, "height": 320, "tabOrder": 0 },
  "visual": {
    "visualType": "pivotTable",
    "query": {
      "queryState": {
        "Rows": {
          "projections": [
            {
              "field": { "Column": { "Expression": { "SourceRef": { "Entity": "Store" } }, "Property": "Chain" } },
              "queryRef": "Store.Chain",
              "nativeQueryRef": "Chain",
              "active": true
            }
          ]
        },
        "Columns": {
          "projections": [
            {
              "field": { "Column": { "Expression": { "SourceRef": { "Entity": "Time" } }, "Property": "FiscalYear" } },
              "queryRef": "Time.FiscalYear",
              "nativeQueryRef": "FiscalYear"
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": { "Measure": { "Expression": { "SourceRef": { "Entity": "Sales" } }, "Property": "TotalSales" } },
              "queryRef": "Sales.TotalSales",
              "nativeQueryRef": "TotalSales"
            }
          ]
        }
      }
    }
  }
}
