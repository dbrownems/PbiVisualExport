{
  // Committed defaults: no environment IDs. Values cascade (later wins):
  // this file < user secrets (shared with the web app) < environment variables < command line.
  //   dotnet user-secrets set XmlaSmoke:DatasetId <id> --project tools/XmlaSmoke
  //   $env:XmlaSmoke__DatasetId = '<id>'        or    dotnet run -- --XmlaSmoke:DatasetId <id>
  "AzureAd": {
    // Used only for the device-code fallback when Azure CLI has no token. Empty = "organizations".
    "TenantId": ""
  },
  "XmlaSmoke": {
    // Required: semantic model (dataset) that executeQueries runs against.
    "DatasetId": "",
    // TMSL used for the offline TOM metadata pass, relative to the project folder.
    "ModelBimPath": "model.bim"
  }
}
