@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Power BI Visual CSV Export</title>
    <style>
        * { box-sizing: border-box; }
        html, body { height: 100%; }
        body { margin: 0; font-family: Segoe UI, system-ui, sans-serif; color: #201f1e; display: flex; flex-direction: column; }
        header { background: #217346; color: #fff; padding: 12px 20px; flex: 0 0 auto; }
        header h1 { font-size: 18px; margin: 0; font-weight: 600; }
        .toolbar { display: flex; gap: 12px; align-items: center; padding: 12px 20px; background: #f3f2f1; border-bottom: 1px solid #e1dfdd; flex-wrap: wrap; flex: 0 0 auto; }
        .toolbar label { font-size: 13px; font-weight: 600; }
        select { min-width: 280px; padding: 6px 8px; font-size: 14px; }
        button { background: #217346; color: #fff; border: 0; padding: 8px 16px; font-size: 14px; border-radius: 3px; cursor: pointer; }
        button.secondary { background: #fff; color: #217346; border: 1px solid #217346; }
        button:disabled { background: #a19f9d; color: #fff; border-color: #a19f9d; cursor: default; }
        #status { font-size: 13px; color: #605e5c; margin-left: auto; }
        .error-container { padding: 12px 20px; color: #a4262c; display: none; flex: 0 0 auto; }
        .debug-panel { display: none; flex: 0 0 auto; max-height: 40vh; overflow: auto; background: #1e1e1e; color: #d4d4d4; border-bottom: 1px solid #000; }
        .debug-head { position: sticky; top: 0; display: flex; align-items: center; gap: 10px; padding: 8px 20px; background: #2d2d2d; color: #fff; font-size: 13px; }
        .debug-head .grow { margin-left: auto; }
        .debug-head #debug-meta { color: #9cdcfe; font-weight: 400; }
        .debug-head button { padding: 4px 10px; font-size: 12px; background: #3c3c3c; border: 1px solid #555; }
        #debug-json { margin: 0; padding: 12px 20px; font-family: Consolas, "Cascadia Code", monospace; font-size: 12px; line-height: 1.45; white-space: pre; }
        #report-container { flex: 1 1 auto; min-height: 0; width: 100%; }
    </style>
</head>
<body>
    <header><h1>Power BI Visual &rarr; CSV Export</h1></header>
    <div class="toolbar">
        <label for="report-select">Report:</label>
        <select id="report-select" disabled><option>Loading&hellip;</option></select>
        <label for="visual-select">Visual:</label>
        <select id="visual-select" disabled><option>Loading report&hellip;</option></select>
        <label title="On: values are formatted with the model's format strings (FORMAT). Off: raw typed values (exact numbers, ISO dates).">
            <input type="checkbox" id="format-chk" checked /> Apply format strings
        </label>
        <label title="On: rows are ordered like the visual (its current sort, read from a captured bookmark). Off: no ORDER BY - faster and lighter on the capacity for multi-million-row exports.">
            <input type="checkbox" id="sort-chk" checked /> Sort like visual
        </label>
        <button id="export-btn" disabled>Export data</button>
        <button id="native-btn" class="secondary" disabled title="Power BI's built-in visual.exportData (first 2,000 rows) - for comparison with the API export">Native export</button>
        <button id="preview-btn" class="secondary" disabled>Preview config</button>
        <span id="status"></span>
    </div>
    <div id="debug-panel" class="debug-panel">
        <div class="debug-head">
            <strong>Visual configuration &rarr; API</strong>
            <span id="debug-meta"></span>
            <span class="grow"></span>
            <button id="debug-copy" type="button">Copy JSON</button>
            <button id="debug-hide" type="button">Hide</button>
        </div>
        <pre id="debug-json"></pre>
    </div>
    <div class="error-container"></div>
    <div id="report-container"></div>

    <script src="https://cdn.jsdelivr.net/npm/powerbi-client@2.23.1/dist/powerbi.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/powerbi-report-authoring@3.0.0/dist/powerbi-report-authoring.js"></script>
    @* The export module's browser client, served by the library (always matches its endpoints). *@
    <script src="/pbi-export/client.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
</body>
</html>
