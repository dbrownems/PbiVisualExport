// columns: c0=Region | c1=Category | c2=Sum of Quantity (measure) | c3=Average of Unit Price (measure) | c4=Total Sales (measure) | c5=Avg Discount (measure) | c6=Return Rate (measure)
// sort: Region ASC, Category ASC (implicit default)
// maxRows: 1000
DEFINE
  VAR _summ = SUMMARIZECOLUMNS('Orders'[Region], 'Orders'[Category], "m_0", SUM('Orders'[Quantity]), "m_1", AVERAGE('Orders'[Unit Price]), "m_2", [Total Sales], "m_3", [Avg Discount], "m_4", [Return Rate])
EVALUATE
TOPN(1000, SELECTCOLUMNS(_summ, "c0", 'Orders'[Region], "c1", 'Orders'[Category], "c2", FORMAT([m_0], "#,0"), "c3", FORMAT([m_1], "\$#,0.00;(\$#,0.00);\$#,0.00"), "c4", FORMAT([m_2], "\$#,0.00;(\$#,0.00);\$#,0.00"), "c5", FORMAT([m_3], "0.00%"), "c6", FORMAT([m_4], "0.0%")), [c0], 1, [c1], 1)
ORDER BY [c0] ASC, [c1] ASC
