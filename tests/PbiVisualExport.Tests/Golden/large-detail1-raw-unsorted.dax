// columns: c0=Row Id | c1=Order Number | c2=Region | c3=Category | c4=Product Name | c5=Customer Name | c6=Postal Code | c7=Quantity | c8=Unit Price | c9=Discount Pct | c10=Sales Amount | c11=Unit Cost | c12=Margin Ratio | c13=Weight Kg | c14=Scientific Value | c15=Big Integer | c16=Priority Code | c17=Rating | c18=Tax Rate | c19=Temperature | c20=Contract Value | c21=Order Date | c22=Ship Date | c23=Order Timestamp | c24=Order Time | c25=Is Returned | c26=Nullable Amount | c27=Notes | c28=Order Year | c29=Order Month | c30=Internal Hash
// sort: off
DEFINE
  VAR _summ = SUMMARIZECOLUMNS('Orders'[Row Id], 'Orders'[Order Number], 'Orders'[Region], 'Orders'[Category], 'Orders'[Product Name], 'Orders'[Customer Name], 'Orders'[Postal Code], 'Orders'[Quantity], 'Orders'[Unit Price], 'Orders'[Discount Pct], 'Orders'[Sales Amount], 'Orders'[Unit Cost], 'Orders'[Margin Ratio], 'Orders'[Weight Kg], 'Orders'[Scientific Value], 'Orders'[Big Integer], 'Orders'[Priority Code], 'Orders'[Rating], 'Orders'[Tax Rate], 'Orders'[Temperature], 'Orders'[Contract Value], 'Orders'[Order Date], 'Orders'[Ship Date], 'Orders'[Order Timestamp], 'Orders'[Order Time], 'Orders'[Is Returned], 'Orders'[Nullable Amount], 'Orders'[Notes], 'Orders'[Order Year], 'Orders'[Order Month], 'Orders'[Internal Hash])
EVALUATE
SELECTCOLUMNS(_summ, "c0", 'Orders'[Row Id], "c1", 'Orders'[Order Number], "c2", 'Orders'[Region], "c3", 'Orders'[Category], "c4", 'Orders'[Product Name], "c5", 'Orders'[Customer Name], "c6", 'Orders'[Postal Code], "c7", 'Orders'[Quantity], "c8", 'Orders'[Unit Price], "c9", 'Orders'[Discount Pct], "c10", 'Orders'[Sales Amount], "c11", 'Orders'[Unit Cost], "c12", 'Orders'[Margin Ratio], "c13", 'Orders'[Weight Kg], "c14", 'Orders'[Scientific Value], "c15", 'Orders'[Big Integer], "c16", 'Orders'[Priority Code], "c17", 'Orders'[Rating], "c18", 'Orders'[Tax Rate], "c19", 'Orders'[Temperature], "c20", 'Orders'[Contract Value], "c21", 'Orders'[Order Date], "c22", 'Orders'[Ship Date], "c23", 'Orders'[Order Timestamp], "c24", 'Orders'[Order Time], "c25", 'Orders'[Is Returned], "c26", 'Orders'[Nullable Amount], "c27", 'Orders'[Notes], "c28", 'Orders'[Order Year], "c29", 'Orders'[Order Month], "c30", 'Orders'[Internal Hash])
