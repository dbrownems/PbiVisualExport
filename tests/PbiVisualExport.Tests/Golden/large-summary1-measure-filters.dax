// columns: c0=Region | c1=Category | c2=Sum of Quantity (measure) | c3=Average of Unit Price (measure) | c4=Total Sales (measure) | c5=Avg Discount (measure) | c6=Return Rate (measure)
// sort: Region ASC, Category ASC (implicit default)
// measure filter: [Total Sales] > 1000
// measure filter: [Order Count] < 10 || [Order Count] >= 500
// measure filter: NOT(ISBLANK(SUM('Orders'[Quantity])))
// measure filter: Top 3 'Orders'[Region] by [Total Sales]
DEFINE
  VAR _tn0 = TOPN(3, SUMMARIZECOLUMNS('Orders'[Region], "tn", [Total Sales]), [tn], 0)
  VAR _vf = FILTER(KEEPFILTERS(SUMMARIZECOLUMNS('Orders'[Region], 'Orders'[Category], _tn0, "m_0", SUM('Orders'[Quantity]), "m_1", AVERAGE('Orders'[Unit Price]), "m_2", [Total Sales], "m_3", [Avg Discount], "m_4", [Return Rate], "vf_0", IGNORE([Order Count]))), [m_2] > 1000 && ([vf_0] < 10 || [vf_0] >= 500) && NOT(ISBLANK([m_0])))
  VAR _summ = SUMMARIZECOLUMNS('Orders'[Region], 'Orders'[Category], _tn0, _vf, "m_0", SUM('Orders'[Quantity]), "m_1", AVERAGE('Orders'[Unit Price]), "m_2", [Total Sales], "m_3", [Avg Discount], "m_4", [Return Rate])
EVALUATE
SELECTCOLUMNS(_summ, "c0", 'Orders'[Region], "c1", 'Orders'[Category], "c2", FORMAT([m_0], "#,0"), "c3", FORMAT([m_1], "\$#,0.00;(\$#,0.00);\$#,0.00"), "c4", FORMAT([m_2], "\$#,0.00;(\$#,0.00);\$#,0.00"), "c5", FORMAT([m_3], "0.00%"), "c6", FORMAT([m_4], "0.0%"))
ORDER BY [c0] ASC, [c1] ASC
